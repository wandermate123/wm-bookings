NEXT_PUBLIC_WHATSAPP_BOOKING_NUMBER=91XXXXXXXXXX

# Neon — get both strings from Dashboard → Connect.
# Pooled (host ends in -pooler): for Next.js / PrismaClient with Neon adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (host does NOT contain "-pooler"): REQUIRED for `prisma migrate` / `migrate deploy`.
# Without this, Migrate often hits P1002 advisory lock timeouts on the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Razorpay (https://dashboard.razorpay.com → API Keys). Never commit real secrets.
# Test: rzp_test_… + test secret. Live: rzp_live_… + live secret (after KYC).
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx